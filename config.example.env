# oracle-snatch-windows 配置模板
# 用法：把本文件复制为 config.env，按注释填写。环境变量同名可覆盖这里的值。
# 重要：config.env 和 ~/.oci/config、*.pem 都含敏感信息，切勿提交到 GitHub。

############################################################
# [必填] 公有子网 OCID
# 控制台：Networking -> Virtual Cloud Networks -> 你的 VCN -> Subnets
# 必须是 PUBLIC subnet，否则拿不到公网 IP
############################################################
SUBNET_ID=REPLACE_ME_SUBNET_OCID

############################################################
# SSH 公钥：注入实例用于登录
# Windows 用正斜杠或双反斜杠。没有密钥就先跑：ssh-keygen -t ed25519
############################################################
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# [可选] compartment OCID，留空默认用 tenancy（根 compartment）
# COMPARTMENT_ID=REPLACE_ME_COMPARTMENT_OCID

# [可选] 镜像 OCID，留空自动选适配 A1.Flex 的最新 Canonical Ubuntu ARM64
# IMAGE_ID=REPLACE_ME_IMAGE_OCID

############################################################
# 抢什么配置
# 注意：Always Free A1 额度是「总量」。2026 年起部分新账号已从
# 4 OCPU / 24 GB 调整为 2 OCPU / 12 GB。开跑前去控制台
# (Governance -> Limits, Quotas and Usage) 查 standard-a1-core-count
# 确认你的实际额度，按额度改这里；超了脚本遇 LimitExceeded 会主动停。
# 合法组合：1/6、2/12、3/18、4/24
############################################################
DISPLAY_NAME=snatch-arm
OCPUS=4
MEMORY_GB=24
BOOT_VOLUME_GB=50

# 重试节奏（秒）：别调太密，只会吃 429 限流
INTERVAL_SECONDS=120
RATE_LIMIT_SLEEP_SECONDS=300

############################################################
# OCI API 凭据：标准 OCI CLI 配置文件
# Oracle 控制台生成 API Key 后，把 Configuration File Preview 内容存到
# %USERPROFILE%\.oci\config，key_file= 指向同目录的 .pem 绝对路径。
############################################################
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# [可选] 抢到后 Telegram 通知，留空禁用
# TG_BOT_TOKEN=
# TG_CHAT_ID=
